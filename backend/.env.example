# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (dev.py uses these discrete vars)
DB_NAME=supplyos
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Database (prod.py — set this INSTEAD of the DB_* vars above if using
# Supabase or another hosted Postgres; overrides DB_* when present)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI provider — "rule_based" works out of the box with no external API key.
# Add real providers in apps/ai/services.py and switch this once configured.
AI_PROVIDER=rule_based

# Email (prod.py SMTP settings — dev.py just prints emails to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Cloud object storage (optional — only used if AWS_STORAGE_BUCKET_NAME is set;
# works with plain S3 or Supabase Storage's S3-compatible endpoint)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
